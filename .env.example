# DPP Autopilot environment template - placeholders only.
# Browser-safe values
DPP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
DPP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
DPP_SHARED_RATE_LIMIT_ENABLED=REPLACE_WITH_true_OR_false

# AI-first server controls. Keep persistence false until the A2 migration is approved/applied.
AI_INTAKE_PERSISTENCE_ENABLED=false
AI_GATEWAY_MODEL=openai/gpt-5.6-sol
# Optional outside Vercel. On Vercel, VERCEL_OIDC_TOKEN can authenticate AI Gateway automatically.
AI_GATEWAY_API_KEY=OPTIONAL_SERVER_SECRET_FOR_LOCAL_OR_NON_VERCEL_RUNTIME

# Server-only values - never expose to browser/static assets.
DPP_SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_SERVER_SECRET_STORE
DPP_DATABASE_URL=REPLACE_IN_SERVER_SECRET_STORE
DPP_REGISTRY_CLIENT_SECRET=REPLACE_IN_SERVER_SECRET_STORE
DPP_WEBHOOK_SIGNING_SECRET=REPLACE_IN_SERVER_SECRET_STORE
DPP_EXPORT_MANIFEST_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_IN_SERVER_SECRET_STORE
