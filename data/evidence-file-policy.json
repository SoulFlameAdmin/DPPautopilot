{
  "version": 6,
  "task": "M13",
  "bucket": "dpp-evidence",
  "max_bytes": 10485760,
  "allowed_content_types": [
    "application/pdf",
    "image/png",
    "image/jpeg",
    "text/csv",
    "application/json"
  ],
  "allowed_related_record_types": [
    "battery_model",
    "battery_item",
    "passport",
    "registry_submission",
    "import_run"
  ],
  "storage_path_rule": "<organization_uuid>/<object path>; '..' segments are forbidden",
  "sha256_format": "64 lowercase hexadecimal characters",
  "note": "Project file policy, not a legal requirement. Private Storage bucket/RLS, deny-by-default metadata registration, tenant-aware registration helper, caller-JWT Edge Function, and upload byte-integrity verification are versioned; M13 remains RED until a real authenticated byte upload/download/delete roundtrip passes and M03 is GREEN.",
  "storage": {
    "private_bucket": true,
    "metadata_registration_required_before_upload": true,
    "read_roles": [
      "owner",
      "admin",
      "editor",
      "viewer"
    ],
    "upload_roles": [
      "owner",
      "admin",
      "editor"
    ],
    "delete_roles": [
      "owner",
      "admin"
    ],
    "update_overwrite_allowed": false,
    "reason_no_overwrite": "Object overwrite is denied so stored SHA-256 metadata cannot silently diverge from object bytes.",
    "hosted_migrations": [
      "supabase/migrations/20260919027000_dpp_evidence_storage.sql",
      "supabase/migrations/20260919028000_dpp_evidence_storage_policy_fix.sql",
      "supabase/migrations/20260919038000_dpp_evidence_storage_registration_tenant_guard.sql"
    ],
    "metadata_registration_helper": "public.dpp_evidence_storage_registered(text)",
    "metadata_registration_tenant_guard": true,
    "edge_function": {
      "name": "dpp-evidence-object",
      "source": "supabase/functions/dpp-evidence-object/index.ts",
      "verify_jwt": true,
      "auth_context": "caller Authorization header is forwarded through a publishable/anon client so Storage RLS remains authoritative",
      "operations": [
        "upload",
        "download",
        "delete"
      ],
      "overwrite_allowed": false,
      "runtime_acceptance_required": true,
      "privileged_server_key_allowed": false,
      "upload_integrity": {
        "metadata_lookup": "caller-RLS SELECT from dpp_evidence_attachments by storage_bucket + storage_path",
        "verifies": [
          "byte_size",
          "sha256_hex",
          "content_type"
        ],
        "hash": "SHA-256 via Web Crypto",
        "mismatch_status": 409,
        "mismatch_code": "EVIDENCE_METADATA_MISMATCH",
        "missing_metadata_status": 403,
        "missing_metadata_code": "EVIDENCE_METADATA_NOT_AVAILABLE",
        "verify_before_storage_upload": true
      }
    }
  }
}
