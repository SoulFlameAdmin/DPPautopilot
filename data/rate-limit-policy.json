{
  "version": 3,
  "task": "R05",
  "status": "partial",
  "strategy": "process_local_fixed_window_precursor",
  "privacy": "Limiter keys store only a truncated SHA-256 digest of normalized IP plus Authorization digest; raw IP addresses and raw bearer credentials are not stored in bucket keys or response metadata.",
  "rules": {
    "public_passport_read": {
      "limit": 30,
      "window_seconds": 60
    },
    "authenticated_read": {
      "limit": 120,
      "window_seconds": 60
    },
    "authenticated_write": {
      "limit": 40,
      "window_seconds": 60
    },
    "export_read": {
      "limit": 20,
      "window_seconds": 60
    },
    "import_write": {
      "limit": 20,
      "window_seconds": 60
    }
  },
  "surfaces": {
    "models": {
      "GET": "authenticated_read",
      "POST": "authenticated_write",
      "PATCH": "authenticated_write",
      "DELETE": "authenticated_write"
    },
    "items": {
      "GET": "authenticated_read",
      "POST": "authenticated_write",
      "PATCH": "authenticated_write",
      "DELETE": "authenticated_write"
    },
    "passport": {
      "public_GET": "public_passport_read",
      "private_GET": "authenticated_read",
      "POST": "authenticated_write",
      "PATCH": "authenticated_write"
    },
    "imports": {
      "GET": "authenticated_read",
      "POST": "import_write",
      "PATCH": "import_write"
    },
    "export": {
      "GET": "export_read"
    },
    "tenant": {
      "GET": "authenticated_read",
      "POST": "authenticated_write"
    }
  },
  "response": {
    "http_status": 429,
    "code": "RATE_LIMITED",
    "message": "Too many requests. Retry later.",
    "headers": [
      "Retry-After",
      "X-RateLimit-Limit",
      "X-RateLimit-Remaining",
      "X-RateLimit-Reset"
    ]
  },
  "limitations": [
    "Process-local buckets do not coordinate across parallel serverless isolates or regions.",
    "Production acceptance requires a shared durable limiter/backend or provider-native distributed rate limiting plus deployed abuse/load evidence."
  ],
  "memory_safety": {
    "max_buckets": 10000,
    "prune_interval_ms": 10000,
    "expired_bucket_eviction": true,
    "active_bucket_cap": true
  }
}
