{
  "version": 7,
  "task": "R05",
  "status": "partial",
  "strategy": "dual_layer_process_local_plus_shared_authenticated_precursor",
  "privacy": "Limiter keys store only truncated SHA-256 digests. Every request consumes a hashed network/IP bucket; requests carrying Authorization also consume a separate hashed credential bucket. Raw IP addresses and raw bearer credentials are never stored in bucket keys or response metadata.",
  "rules": {
    "public_passport_read": {
      "limit": 30,
      "window_seconds": 60
    },
    "authenticated_read": {
      "limit": 120,
      "window_seconds": 60
    },
    "authenticated_write": {
      "limit": 40,
      "window_seconds": 60
    },
    "export_read": {
      "limit": 20,
      "window_seconds": 60
    },
    "import_write": {
      "limit": 20,
      "window_seconds": 60
    }
  },
  "surfaces": {
    "models": {
      "GET": "authenticated_read",
      "POST": "authenticated_write",
      "PATCH": "authenticated_write",
      "DELETE": "authenticated_write"
    },
    "items": {
      "GET": "authenticated_read",
      "POST": "authenticated_write",
      "PATCH": "authenticated_write",
      "DELETE": "authenticated_write"
    },
    "passport": {
      "public_GET": "public_passport_read",
      "private_GET": "authenticated_read",
      "POST": "authenticated_write",
      "PATCH": "authenticated_write"
    },
    "imports": {
      "GET": "authenticated_read",
      "POST": "import_write",
      "PATCH": "import_write"
    },
    "export": {
      "GET": "export_read"
    },
    "tenant": {
      "GET": "authenticated_read",
      "POST": "authenticated_write"
    },
    "organizations": {
      "POST": "authenticated_write"
    },
    "members": {
      "GET": "authenticated_read",
      "POST": "authenticated_write",
      "PATCH": "authenticated_write",
      "DELETE": "authenticated_write"
    }
  },
  "response": {
    "http_status": 429,
    "code": "RATE_LIMITED",
    "message": "Too many requests. Retry later.",
    "headers": [
      "Retry-After",
      "X-RateLimit-Limit",
      "X-RateLimit-Remaining",
      "X-RateLimit-Reset"
    ]
  },
  "limitations": [
    "The shared Supabase backend is implemented and regression-tested but is not yet wired into deployed API runtime; current request enforcement remains process-local.",
    "Anonymous public passport traffic remains process-local until a safe distributed identity path is available without exposing a directly abusable anonymous consume RPC.",
    "Production acceptance still requires deployed multi-isolate/real-network abuse and load evidence."
  ],
  "memory_safety": {
    "max_buckets": 10000,
    "prune_interval_ms": 10000,
    "expired_bucket_eviction": true,
    "active_bucket_cap": true
  },
  "identity_safety": {
    "network_bucket_always_enforced": true,
    "credential_bucket_when_authorization_present": true,
    "allow_only_when_all_buckets_within_limit": true,
    "bearer_rotation_cannot_reset_network_budget": true,
    "active_request_buckets_protected_from_cap_eviction": true
  },
  "shared_backend": {
    "status": "implemented_not_runtime_wired",
    "table": "dpp_rate_limit_buckets",
    "rpc": "dpp_rate_limit_consume(text,integer,integer,timestamptz)",
    "scope": "authenticated network/credential budgets only",
    "atomic_increment": true,
    "fixed_window_reset": true,
    "row_level_security": true,
    "direct_table_grants": false,
    "anon_rpc_execute": false,
    "authenticated_rpc_execute": true,
    "stale_row_retention": "opportunistic cleanup after reset_at + 10 minutes",
    "application_key_contract": "surface|rule|network:<32 hex> or surface|rule|credential:<24 hex>"
  }
}
