{
  "version": 8,
  "task": "R08",
  "status": "partial",
  "scope": "DPP Autopilot only; shared Supabase non-dpp_* data is excluded.",
  "export": {
    "implementation": "M21 dpp_api_export_bundle() owner/admin active-tenant export + optional serverless evidence-byte augmentation",
    "required_before_org_deletion": true,
    "evidence_bytes_precursor": {
      "endpoint": "GET /api/export?include_evidence=1[&evidence_offset=N&evidence_limit=N][&evidence_manifest_signed=1][&evidence_manifest_token=TOKEN][&format=ndjson]",
      "authorization": "owner/admin enforced by dpp_api_export_bundle(); caller JWT reused for private dpp-evidence object reads",
      "integrity": "byte_size + SHA-256 verified against evidence_manifest before inclusion",
      "encoding": "base64",
      "inline_limit_bytes": 26214400,
      "failure_mode": "fail closed on unavailable object, response metadata/integrity mismatch, or size limit",
      "pagination": {
        "offset_param": "evidence_offset",
        "limit_param": "evidence_limit",
        "default_limit_when_paged": 25,
        "max_limit": 100,
        "page_metadata": [
          "manifest_object_count",
          "offset",
          "limit",
          "has_more",
          "next_offset"
        ],
        "byte_cap_scope": "selected page only",
        "resume_manifest_sha256": {
          "query_param": "evidence_manifest_sha256",
          "response_field": "manifest_sha256",
          "algorithm": "SHA-256 over canonicalized evidence manifest identity/size/hash tuples",
          "mismatch_status": 409,
          "mismatch_code": "EVIDENCE_EXPORT_MANIFEST_CHANGED",
          "invalid_status": 400,
          "invalid_code": "EVIDENCE_EXPORT_MANIFEST_INVALID",
          "failure_stage": "before evidence object download"
        },
        "signed_resume_manifest": {
          "request_flag": "evidence_manifest_signed",
          "request_token_param": "evidence_manifest_token",
          "response_token_field": "manifest_token",
          "response_algorithm_field": "manifest_signature_algorithm",
          "algorithm": "HMAC-SHA256-v1 over canonical manifest SHA-256",
          "signing_key_env": "DPP_EXPORT_MANIFEST_SIGNING_KEY",
          "minimum_signing_key_bytes": 32,
          "tamper_status": 400,
          "tamper_code": "EVIDENCE_EXPORT_MANIFEST_TOKEN_INVALID",
          "signing_unavailable_status": 500,
          "signing_unavailable_code": "EVIDENCE_EXPORT_SIGNING_UNAVAILABLE",
          "manifest_drift_status": 409,
          "manifest_drift_code": "EVIDENCE_EXPORT_MANIFEST_CHANGED",
          "failure_stage": "before evidence object download"
        }
      }
    },
    "current_gap": "The ndjson-v1 path now uses incremental response-body processing and verified temporary spooling instead of page-wide evidence byte/base64 accumulation. Final archive packaging and real authenticated deployed large-tenant acceptance remain unproven.",
    "streaming_package_precursor": {
      "query": "format=ndjson",
      "media_type": "application/x-ndjson; charset=utf-8",
      "package_version": "ndjson-v1",
      "content_disposition": "attachment; filename=\"dpp-export.ndjson\"",
      "record_order": [
        "dpp_export_header",
        "dpp_bundle",
        "dpp_evidence (zero or more)",
        "dpp_export_end"
      ],
      "evidence_encoding": "base64",
      "integrity_gate": "selected evidence bytes and response metadata are verified before the first NDJSON record is emitted",
      "signed_resume_compatible": true,
      "current_limit": "final archive format and real authenticated deployed large-tenant acceptance remain unproven",
      "memory_strategy": "incremental response-body chunks with incremental SHA-256/base64 into a verified temporary spool before response emission",
      "spool_contract": "verified_tmpfile_v1"
    }
  },
  "retention_rules": [
    {
      "id": "import_terminal_staging",
      "stores": [
        "dpp_import_runs",
        "dpp_import_rows"
      ],
      "policy": "purge_terminal_after_days",
      "terminal_statuses": [
        "invalid",
        "committed"
      ],
      "minimum_age_days": 30,
      "implemented": true,
      "notes": "staged/validated in-progress imports are never purged by the precursor"
    },
    {
      "id": "passport_history",
      "stores": [
        "dpp_passports",
        "dpp_passport_versions"
      ],
      "policy": "retain_until_approved_regulatory_period",
      "implemented": false,
      "blocks_org_deletion": true
    },
    {
      "id": "registry_history",
      "stores": [
        "dpp_registry_submissions"
      ],
      "policy": "retain_until_external_recipient_and_legal_period_approved",
      "implemented": false,
      "blocks_org_deletion": true
    },
    {
      "id": "evidence_objects",
      "stores": [
        "dpp_evidence_attachments",
        "Supabase Storage dpp-evidence"
      ],
      "policy": "retain_until_object_lifecycle_and_deletion_are_proven",
      "implemented": false,
      "blocks_org_deletion": true
    },
    {
      "id": "audit_history",
      "stores": [
        "dpp_audit_log"
      ],
      "policy": "immutable_audit_exception_pending_accepted_period_and_minimization",
      "implemented": false,
      "blocks_org_deletion": true,
      "notes": "audit rows intentionally survive relational cascades; before/after snapshots require an accepted minimization/redaction policy before destructive org deletion"
    },
    {
      "id": "auth_identity",
      "stores": [
        "auth.users",
        "dpp_organization_members",
        "dpp_user_tenant_context"
      ],
      "policy": "membership_lifecycle_now_auth_account_deletion_pending",
      "implemented": false,
      "blocks_user_deletion": true
    }
  ],
  "org_deletion": {
    "enabled": false,
    "fail_closed": true,
    "readiness_rpc": "dpp_api_retention_status()",
    "blockers": [
      "exhaustive production evidence-byte export/package acceptance not proven",
      "passport/version regulatory retention period not accepted",
      "registry submission retention/external recipient terms not accepted",
      "evidence storage deletion lifecycle not accepted",
      "audit snapshot retention/minimization exception not accepted",
      "auth account deletion workflow not accepted"
    ],
    "impact_preview_rpc": "dpp_api_org_deletion_impact()",
    "impact_preview": {
      "destructive": false,
      "roles": [
        "owner",
        "admin"
      ],
      "counts": [
        "organization_members",
        "distinct_member_users",
        "active_tenant_contexts",
        "battery_models",
        "battery_items",
        "passports",
        "passport_versions",
        "import_mappings",
        "import_runs",
        "import_rows",
        "registry_submissions",
        "evidence_metadata",
        "evidence_declared_bytes",
        "audit_rows"
      ],
      "external_storage_enumeration_required": true,
      "auth_users_deleted_by_org_delete": false,
      "ready_for_destructive_delete": false
    }
  },
  "implemented_actions": {
    "import_staging_purge_rpc": "dpp_api_purge_import_staging(timestamptz)",
    "roles": [
      "owner",
      "admin"
    ],
    "minimum_age_days": 30,
    "auditable": true,
    "org_deletion_impact_preview_rpc": "dpp_api_org_deletion_impact()"
  }
}
